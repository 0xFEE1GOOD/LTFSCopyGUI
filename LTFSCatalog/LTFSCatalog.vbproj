<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline catalog of LTFS tapes, built from the index copies LTFSCopyGUI saves in its schema folder.
       Builds into LTFSCopyGUI's own output folder so the installer and the portable archive ship it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>LTFSCatalog</RootNamespace>
    <AssemblyName>LTFSCatalog</AssemblyName>
    <StartupObject>LTFSCatalog.Program</StartupObject>
    <MyType>Empty</MyType>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationIcon>..\LTFSCopyGUI\Assets\LTFSCopyGUIIcon.ico</ApplicationIcon>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- App.config carries the same binding redirects as LTFSCopyGUI.exe.config (shared DLLs). -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <Version>1.0.0</Version>
    <Product>LTFSCatalog</Product>
    <Description>Offline catalog of LTFS tapes for LTFSCopyGUI</Description>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>..\LTFSCopyGUI\bin\x64\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' != 'x64'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <OutputPath>..\LTFSCopyGUI\bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <!-- Already copied into the shared output folder by LTFSCopyGUI (same version); not copied again here. -->
    <Reference Include="ZstdSharp">
      <HintPath>..\packages\ZstdSharp.Port.0.8.8\lib\net462\ZstdSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Ships System.Data.SQLite.dll and x86\ / x64\ SQLite.Interop.dll; used through ADO.NET base classes. -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\LTFSCopyGUI\Assets\DirRoot.png" Link="Assets\DirRoot.png" LogicalName="LTFSCatalog.DirRoot.png" />
    <EmbeddedResource Include="..\LTFSCopyGUI\Assets\Dir.png" Link="Assets\Dir.png" LogicalName="LTFSCatalog.Dir.png" />
    <EmbeddedResource Include="..\LTFSCopyGUI\Assets\File.png" Link="Assets\File.png" LogicalName="LTFSCatalog.File.png" />
    <EmbeddedResource Include="..\LTFSCopyGUI\Assets\Archive.png" Link="Assets\Archive.png" LogicalName="LTFSCatalog.Archive.png" />
  </ItemGroup>

</Project>
